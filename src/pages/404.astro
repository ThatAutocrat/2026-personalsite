---
// Space-themed 404 page for Astro
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 — Lost in Space</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --void: #02020a;
      --deep: #070718;
      --nebula-blue: #0d1b4b;
      --nebula-purple: #1a0b35;
      --star-white: #e8eaff;
      --accent-cyan: #00d4ff;
      --accent-violet: #9d50ff;
      --accent-rose: #ff4b91;
      --glow-cyan: rgba(0, 212, 255, 0.15);
      --glow-violet: rgba(157, 80, 255, 0.12);
      --font-display: 'Bebas Neue', sans-serif;
      --font-mono: 'Space Mono', monospace;
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
    }

    body {
      background: var(--void);
      color: var(--star-white);
      font-family: var(--font-mono);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      position: relative;
    }

    /* ── STARFIELD ── */
    #starfield {
      position: fixed; inset: 0;
      z-index: 0;
      pointer-events: none;
      transition: transform 0.1s ease-out;
    }

    /* ── NEBULA GLOW BG ── */
    .nebula {
      position: fixed; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 60% 40% at 20% 50%, rgba(13, 27, 75, 0.6) 0%, transparent 70%),
        radial-gradient(ellipse 50% 60% at 80% 30%, rgba(26, 11, 53, 0.7) 0%, transparent 65%),
        radial-gradient(ellipse 30% 50% at 60% 80%, rgba(157, 80, 255, 0.08) 0%, transparent 60%),
        radial-gradient(ellipse 40% 30% at 30% 20%, rgba(0, 212, 255, 0.06) 0%, transparent 55%);
      pointer-events: none;
      transition: transform 0.15s ease-out;
    }

    /* ── SCAN LINE OVERLAY ── */
    .scanlines {
      position: fixed; inset: 0; z-index: 1;
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0,0,0,0.04) 2px,
        rgba(0,0,0,0.04) 4px
      );
      pointer-events: none;
    }

    /* ── MAIN CONTENT ── */
    .stage {
      position: relative; z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      user-select: none;
      transition: transform 0.12s ease-out;
    }

    /* ── 3D 404 LETTERS ── */
    .letters-wrap {
      position: relative;
      line-height: 1;
    }

    .four-o-four {
      font-family: var(--font-display);
      font-size: clamp(180px, 22vw, 320px);
      letter-spacing: -0.01em;
      line-height: 0.85;
      position: relative;
      display: block;

      color: #fff;
      text-shadow:
        2px 2px 0 #c8caff,
        4px 4px 0 #a8abee,
        6px 6px 0 #8487dd,
        8px 8px 0 #6264cc,
        10px 10px 0 #4548bb,
        12px 12px 0 #2d30aa,
        14px 14px 0 #1e2199,
        16px 16px 0 #131688,
        18px 18px 0 #0b0d77,
        20px 20px 40px rgba(0, 212, 255, 0.25),
        20px 20px 80px rgba(157, 80, 255, 0.3),
        0 0 120px rgba(0, 212, 255, 0.08);

      background: linear-gradient(
        135deg,
        #ffffff 0%,
        #d0d4ff 25%,
        #9d9fff 50%,
        #7b7dff 70%,
        #5a5cee 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;

      animation: floatLetters 6s ease-in-out infinite;
      filter: drop-shadow(0 0 60px rgba(157, 80, 255, 0.5))
              drop-shadow(0 0 120px rgba(0, 212, 255, 0.25));
    }

    @keyframes floatLetters {
      0%, 100% { transform: translateY(0px) rotate(-0.3deg); }
      33%       { transform: translateY(-12px) rotate(0.2deg); }
      66%       { transform: translateY(-6px) rotate(-0.1deg); }
    }

    /* ── CHROME OUTLINE GHOST ── */
    .four-o-four-outline {
      font-family: var(--font-display);
      font-size: clamp(180px, 22vw, 320px);
      letter-spacing: -0.01em;
      line-height: 0.85;
      position: absolute;
      top: 6px; left: 6px;
      color: transparent;
      -webkit-text-stroke: 1px rgba(0, 212, 255, 0.2);
      animation: floatLetters 6s ease-in-out infinite;
      animation-delay: -0.1s;
      pointer-events: none;
    }

    /* ── ASTRONAUT ── */
    .astronaut-wrap {
      position: absolute;
      top: -1px; right: -80px;
      width: 110px; height: 110px;
      animation: tumble 12s linear infinite;
      z-index: 20;
      cursor: pointer;
      transition: transform 0.3s ease-out;
      /* parallax layer */
    }

    .astronaut-wrap.clicked {
      animation: spinout 0.6s cubic-bezier(0.36,0.07,0.19,0.97) forwards,
                 tumble 12s linear 0.6s infinite;
    }

    @keyframes tumble {
      from { transform: rotate(0deg) translateX(20px) rotate(0deg); }
      to   { transform: rotate(360deg) translateX(20px) rotate(-360deg); }
    }

    @keyframes spinout {
      0%   { transform: scale(1) rotate(0deg); }
      30%  { transform: scale(1.3) rotate(180deg); }
      60%  { transform: scale(0.9) rotate(340deg); }
      100% { transform: scale(1) rotate(360deg); }
    }

    .astronaut-wrap svg {
      width: 100%; height: 100%;
      filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.5));
    }

    /* ── SPEECH BUBBLE ── */
    .speech-bubble {
      position: absolute;
      top: -52px; right: -10px;
      background: rgba(0, 212, 255, 0.08);
      border: 1px solid rgba(0, 212, 255, 0.4);
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      padding: 7px 12px;
      white-space: nowrap;
      clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
      opacity: 0;
      transform: translateY(6px) scale(0.9);
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
      z-index: 30;
    }

    .speech-bubble::after {
      content: '';
      position: absolute;
      bottom: -7px; left: 50%;
      transform: translateX(-50%);
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 7px solid rgba(0, 212, 255, 0.4);
    }

    .speech-bubble.visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* ── CORRUPT URL DISPLAY ── */
    .corrupt-url {
      margin-top: 18px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      color: rgba(157, 80, 255, 0.6);
      text-align: center;
      min-height: 18px;
      position: relative;
    }

    .corrupt-url .url-label {
      color: rgba(200, 210, 255, 0.25);
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      display: block;
      margin-bottom: 4px;
    }

    .corrupt-url .url-text {
      display: inline-block;
      position: relative;
    }

    .corrupt-url .url-text.glitching {
      animation: glitchText 0.08s steps(1) infinite;
    }

    @keyframes glitchText {
      0%   { clip-path: inset(0 0 85% 0); transform: translateX(-2px); color: var(--accent-cyan); }
      25%  { clip-path: inset(40% 0 40% 0); transform: translateX(2px); color: var(--accent-rose); }
      50%  { clip-path: inset(70% 0 10% 0); transform: translateX(-1px); color: var(--accent-violet); }
      75%  { clip-path: inset(20% 0 70% 0); transform: translateX(3px); color: var(--accent-cyan); }
      100% { clip-path: inset(0); transform: translateX(0); color: rgba(157, 80, 255, 0.6); }
    }

    /* ── QUOTE ── */
    .quote-block {
      margin-top: 16px;
      text-align: center;
      position: relative;
    }

    .quote-line {
      width: 60px; height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
      margin: 0 auto 20px;
    }

    .quote-text {
      font-family: var(--font-mono);
      font-size: clamp(13px, 1.8vw, 16px);
      font-style: italic;
      color: rgba(200, 210, 255, 0.85);
      letter-spacing: 0.04em;
      line-height: 1.6;
      max-width: 500px;
    }

    .quote-text em {
      font-style: normal;
      color: var(--accent-cyan);
    }

    .quote-attr {
      margin-top: 10px;
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(157, 80, 255, 0.8);
    }

    /* ── STATUS BAR ── */
    .status-bar {
      margin-top: 40px;
      display: flex;
      align-items: center;
      gap: 24px;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(200, 210, 255, 0.4);
    }

    .status-bar .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent-cyan);
      box-shadow: 0 0 8px var(--accent-cyan);
      animation: blink 2s ease-in-out infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0.2; }
    }

    .status-divider {
      width: 1px; height: 12px;
      background: rgba(200, 210, 255, 0.15);
    }

    /* ── CTA BUTTON ── */
    .cta-wrap {
      margin-top: 36px;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 32px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--star-white);
      border: 1px solid rgba(0, 212, 255, 0.3);
      background: rgba(0, 212, 255, 0.04);
      cursor: pointer;
      position: relative;
      transition: all 0.3s ease;
      clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
    }

    .cta-btn::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(0,212,255,0.08), rgba(157,80,255,0.08));
      opacity: 0;
      transition: opacity 0.3s;
    }

    .cta-btn:hover::before { opacity: 1; }
    .cta-btn:hover {
      border-color: rgba(0, 212, 255, 0.7);
      color: var(--accent-cyan);
      box-shadow: 0 0 30px rgba(0, 212, 255, 0.2), inset 0 0 30px rgba(0,212,255,0.03);
    }

    .cta-btn:hover .arrow { transform: translateX(4px); }

    .arrow {
      display: inline-block;
      transition: transform 0.3s ease;
    }

    /* ── CORNER DECORATIONS ── */
    .corner {
      position: fixed;
      width: 60px; height: 60px;
      z-index: 5;
      pointer-events: none;
    }

    .corner--tl { top: 24px; left: 24px; border-top: 1px solid rgba(0,212,255,0.3); border-left: 1px solid rgba(0,212,255,0.3); }
    .corner--tr { top: 24px; right: 24px; border-top: 1px solid rgba(0,212,255,0.3); border-right: 1px solid rgba(0,212,255,0.3); }
    .corner--bl { bottom: 24px; left: 24px; border-bottom: 1px solid rgba(0,212,255,0.3); border-left: 1px solid rgba(0,212,255,0.3); }
    .corner--br { bottom: 24px; right: 24px; border-bottom: 1px solid rgba(0,212,255,0.3); border-right: 1px solid rgba(0,212,255,0.3); }

    /* ── COORDINATES ── */
    .coords {
      position: fixed;
      bottom: 28px; left: 50%;
      transform: translateX(-50%);
      font-size: 10px;
      letter-spacing: 0.2em;
      color: rgba(200, 210, 255, 0.2);
      z-index: 5;
      font-family: var(--font-mono);
    }

    /* ── PLANET ── */
    .planet {
      position: fixed;
      bottom: -80px; right: -60px;
      width: 280px; height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%,
        rgba(157, 80, 255, 0.4) 0%,
        rgba(26, 11, 53, 0.9) 50%,
        rgba(2, 2, 10, 1) 100%
      );
      box-shadow:
        inset -20px -20px 60px rgba(0, 0, 0, 0.8),
        inset 20px 20px 60px rgba(157, 80, 255, 0.15),
        0 0 80px rgba(157, 80, 255, 0.2);
      z-index: 2;
      pointer-events: none;
      transition: transform 0.2s ease-out;
    }

    .planet::after {
      content: '';
      position: absolute;
      top: 38%; left: -30%;
      width: 160%; height: 28%;
      border-radius: 50%;
      border: 2px solid rgba(157, 80, 255, 0.3);
      transform: rotateX(75deg);
      box-shadow: 0 0 20px rgba(157, 80, 255, 0.15);
    }

    /* ── KONAMI OVERLAY ── */
    .konami-overlay {
      position: fixed; inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(2, 2, 10, 0.92);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .konami-overlay.active {
      opacity: 1;
      pointer-events: all;
    }

    .konami-text {
      font-family: var(--font-display);
      font-size: clamp(32px, 6vw, 72px);
      letter-spacing: 0.1em;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet), var(--accent-rose));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-align: center;
      animation: konamiPulse 1s ease-in-out infinite alternate;
      margin-bottom: 16px;
    }

    .konami-sub {
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 0.2em;
      color: rgba(200, 210, 255, 0.5);
      text-transform: uppercase;
    }

    .konami-close {
      margin-top: 40px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(0, 212, 255, 0.5);
      cursor: pointer;
      border: 1px solid rgba(0,212,255,0.2);
      padding: 10px 24px;
      background: transparent;
      transition: all 0.2s;
    }

    .konami-close:hover {
      color: var(--accent-cyan);
      border-color: rgba(0,212,255,0.6);
    }

    @keyframes konamiPulse {
      from { filter: drop-shadow(0 0 20px rgba(0,212,255,0.5)); }
      to   { filter: drop-shadow(0 0 60px rgba(157,80,255,0.8)); }
    }

    /* konami star burst */
    .konami-stars {
      position: absolute; inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .k-star {
      position: absolute;
      width: 4px; height: 4px;
      border-radius: 50%;
      animation: kStarFly 1.5s ease-out forwards;
    }

    @keyframes kStarFly {
      from { transform: translate(0,0) scale(1); opacity: 1; }
      to   { transform: translate(var(--tx), var(--ty)) scale(0); opacity: 0; }
    }
  </style>
</head>
<body>

  <div class="nebula" id="nebula"></div>
  <div class="scanlines"></div>
  <canvas id="starfield"></canvas>

  <!-- Corner HUD decorations -->
  <div class="corner corner--tl"></div>
  <div class="corner corner--tr"></div>
  <div class="corner corner--bl"></div>
  <div class="corner corner--br"></div>

  <!-- Planet -->
  <div class="planet" id="planet"></div>

  <!-- Main stage -->
  <main class="stage" id="stage">
    <div class="letters-wrap">
      <span class="four-o-four-outline" aria-hidden="true">404</span>
      <span class="four-o-four" role="img" aria-label="404">404</span>

      <!-- Floating astronaut SVG (no tether) -->
      <div class="astronaut-wrap" id="astronaut" aria-label="Click the astronaut" role="button" tabindex="0">
        <!-- Speech bubble -->
        <div class="speech-bubble" id="speechBubble">Still lost…</div>
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <!-- Suit body -->
          <ellipse cx="50" cy="62" rx="22" ry="26" fill="#d0d4ff" />
          <!-- Helmet -->
          <circle cx="50" cy="34" r="20" fill="#e8eaff" />
          <!-- Visor -->
          <ellipse cx="50" cy="34" rx="13" ry="11" fill="#1a2a6c" />
          <ellipse cx="46" cy="30" rx="3" ry="2.5" fill="rgba(0,212,255,0.5)" />
          <!-- Arms -->
          <ellipse cx="26" cy="60" rx="6" ry="14" fill="#c0c4f0" transform="rotate(-15 26 60)" />
          <ellipse cx="74" cy="60" rx="6" ry="14" fill="#c0c4f0" transform="rotate(15 74 60)" />
          <!-- Gloves -->
          <circle cx="22" cy="72" r="7" fill="#a0a4e0" />
          <circle cx="78" cy="72" r="7" fill="#a0a4e0" />
          <!-- Legs -->
          <ellipse cx="40" cy="86" rx="8" ry="12" fill="#b0b4e8" />
          <ellipse cx="60" cy="86" rx="8" ry="12" fill="#b0b4e8" />
          <!-- Boots -->
          <ellipse cx="40" cy="96" rx="9" ry="5" fill="#8088cc" />
          <ellipse cx="60" cy="96" rx="9" ry="5" fill="#8088cc" />
          <!-- Backpack -->
          <rect x="60" y="52" width="14" height="18" rx="3" fill="#b0b4e8" />
          <!-- Stars on visor reflection -->
          <circle cx="55" cy="28" r="1" fill="rgba(255,255,255,0.7)" />
          <circle cx="58" cy="33" r="0.6" fill="rgba(255,255,255,0.5)" />
        </svg>
      </div>
    </div>

    <!-- Corrupt URL display -->
    <div class="corrupt-url" id="corruptUrl">
      <span class="url-label">Last known signal</span>
      <span class="url-text" id="urlText"></span>
    </div>

    <div class="quote-block">
      <div class="quote-line"></div>
      <p class="quote-text">
        "Space is big. You just won't believe how vastly, hugely,
        <em>mind-bogglingly big</em> it is — and yet, somehow,
        this page managed to get itself lost in all of it."
      </p>
      <p class="quote-attr">— Deep Space Navigation Error, Stardate 404</p>
    </div>

    <div class="status-bar">
      <span class="dot"></span>
      <span>Signal lost</span>
      <span class="status-divider"></span>
      <span>Error 404</span>
      <span class="status-divider"></span>
      <span>Sector unknown</span>
    </div>

    <div class="cta-wrap">
      <a href="/" class="cta-btn">
        <span class="arrow">←</span> Go Back Home
      </a>
    </div>
  </main>

  <div class="coords" aria-hidden="true">RA 00h 42m 44s · DEC +41° 16′ 09″</div>

  <!-- Konami overlay -->
  <div class="konami-overlay" id="konamiOverlay">
    <div class="konami-stars" id="konamiStars"></div>
    <div class="konami-text">⬆⬆⬇⬇⬅➡⬅➡<br>CHEAT CODE ACCEPTED</div>
    <div class="konami-sub">You found the secret — still lost though</div>
    <button class="konami-close" id="konamiClose">Resume drifting →</button>
  </div>

  <script>
    // ── STARFIELD ──
    const canvas = document.getElementById('starfield');
    const ctx = canvas.getContext('2d');
    let w, h, stars;

    const STAR_COUNT = 280;
    const SHOOTING_INTERVAL = 3500;

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }

    function initStars() {
      stars = Array.from({ length: STAR_COUNT }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.6 + 0.2,
        o: Math.random() * 0.8 + 0.2,
        speed: Math.random() * 0.4 + 0.05,
        flicker: Math.random() * Math.PI * 2,
        flickerSpeed: Math.random() * 0.02 + 0.005,
      }));
    }

    function drawStars() {
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        s.flicker += s.flickerSpeed;
        const opacity = s.o * (0.7 + 0.3 * Math.sin(s.flicker));
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        const hue = (s.x / w) * 60 + 200;
        ctx.fillStyle = `hsla(${hue}, 60%, 90%, ${opacity})`;
        ctx.fill();
      }
    }

    let shooters = [];

    function spawnShooter() {
      const sx = Math.random() * w * 0.6;
      const sy = Math.random() * h * 0.4;
      shooters.push({ x: sx, y: sy, len: 120 + Math.random() * 80, life: 1 });
    }

    function drawShooters() {
      shooters = shooters.filter(s => s.life > 0);
      for (const s of shooters) {
        const ex = s.x + s.len * s.life;
        const ey = s.y + s.len * 0.35 * s.life;
        const grad = ctx.createLinearGradient(s.x, s.y, ex, ey);
        grad.addColorStop(0, `rgba(0,212,255,0)`);
        grad.addColorStop(0.5, `rgba(0,212,255,${s.life * 0.8})`);
        grad.addColorStop(1, `rgba(255,255,255,${s.life})`);
        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(ex, ey);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        s.life -= 0.025;
      }
    }

    function loop() {
      drawStars();
      drawShooters();
      requestAnimationFrame(loop);
    }

    window.addEventListener('resize', () => { resize(); initStars(); });
    resize(); initStars();
    setInterval(spawnShooter, SHOOTING_INTERVAL);
    spawnShooter();
    requestAnimationFrame(loop);


    // ── MOUSE PARALLAX ──
    const stage    = document.getElementById('stage');
    const nebula   = document.getElementById('nebula');
    const planet   = document.getElementById('planet');
    const astronaut = document.getElementById('astronaut');

    let mouseX = 0, mouseY = 0;
    let targetX = 0, targetY = 0;

    document.addEventListener('mousemove', e => {
      // Normalize -1 to 1
      mouseX = (e.clientX / window.innerWidth  - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    // Smooth parallax via lerp in rAF
    function parallaxLoop() {
      targetX += (mouseX - targetX) * 0.06;
      targetY += (mouseY - targetY) * 0.06;

      // Stage moves gently
      stage.style.transform = `translate(${targetX * -8}px, ${targetY * -8}px)`;
      // Nebula moves opposite and slower
      nebula.style.transform = `translate(${targetX * 12}px, ${targetY * 12}px)`;
      // Planet moves on its own layer
      planet.style.transform = `translate(${targetX * -18}px, ${targetY * -18}px)`;
      // Canvas (stars) offset very slightly
      canvas.style.transform = `translate(${targetX * -4}px, ${targetY * -4}px)`;

      requestAnimationFrame(parallaxLoop);
    }
    parallaxLoop();


    // ── CLICKABLE ASTRONAUT ──
    const speechBubble = document.getElementById('speechBubble');
    const bubbleMessages = [
      'Still lost…',
      'Hello?? Anyone?',
      'Tried /home already.',
      'This void is… nice.',
      'Send snacks pls.',
      '404 days adrift.',
    ];
    let bubbleTimeout = null;
    let msgIndex = 0;
    let isClicked = false;

    astronaut.addEventListener('click', () => {
      if (isClicked) return;
      isClicked = true;

      // Swap animation
      astronaut.classList.add('clicked');

      // Show speech bubble
      speechBubble.textContent = bubbleMessages[msgIndex % bubbleMessages.length];
      msgIndex++;
      speechBubble.classList.add('visible');

      clearTimeout(bubbleTimeout);
      bubbleTimeout = setTimeout(() => {
        speechBubble.classList.remove('visible');
      }, 2400);

      // Re-enable after spinout
      setTimeout(() => {
        astronaut.classList.remove('clicked');
        isClicked = false;
      }, 650);
    });

    astronaut.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') astronaut.click();
    });


    // ── CORRUPT URL DISPLAY ──
    const urlText = document.getElementById('urlText');
    const rawPath = window.location.pathname || '/unknown-sector';

    const GLITCH_CHARS = '!<>-_\\/[]{}—=+*^?#@$%&~`|░▒▓█';

    function randomChar() {
      return GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)];
    }

    function corruptReveal(target, finalStr, duration = 1400) {
      const len = finalStr.length;
      let revealedUp = 0;
      const startTime = performance.now();

      function frame(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        revealedUp = Math.floor(progress * len);

        let display = '';
        for (let i = 0; i < len; i++) {
          if (i < revealedUp) {
            display += finalStr[i];
          } else {
            display += randomChar();
          }
        }
        target.textContent = display;

        if (progress < 1) {
          requestAnimationFrame(frame);
        } else {
          target.textContent = finalStr;
          // Occasional micro-glitch after reveal
          startMicroGlitch(target, finalStr);
        }
      }

      requestAnimationFrame(frame);
    }

    function startMicroGlitch(target, finalStr) {
      setInterval(() => {
        if (Math.random() > 0.6) return;
        target.classList.add('glitching');
        setTimeout(() => target.classList.remove('glitching'), 180);
      }, 2800);
    }

    // Kick off on load
    corruptReveal(urlText, rawPath, 1600);


    // ── KONAMI CODE ──
    const KONAMI = [
      'ArrowUp','ArrowUp',
      'ArrowDown','ArrowDown',
      'ArrowLeft','ArrowRight',
      'ArrowLeft','ArrowRight',
      'b','a'
    ];
    let konamiProgress = 0;

    const konamiOverlay = document.getElementById('konamiOverlay');
    const konamiStars   = document.getElementById('konamiStars');
    const konamiClose   = document.getElementById('konamiClose');

    document.addEventListener('keydown', e => {
      if (e.key === KONAMI[konamiProgress]) {
        konamiProgress++;
        if (konamiProgress === KONAMI.length) {
          konamiProgress = 0;
          triggerKonami();
        }
      } else {
        konamiProgress = e.key === KONAMI[0] ? 1 : 0;
      }
    });

    function triggerKonami() {
      konamiOverlay.classList.add('active');
      // Burst stars
      konamiStars.innerHTML = '';
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      const colors = ['#00d4ff','#9d50ff','#ff4b91','#fff'];
      for (let i = 0; i < 60; i++) {
        const star = document.createElement('div');
        star.className = 'k-star';
        const angle = (i / 60) * Math.PI * 2;
        const dist = 100 + Math.random() * 300;
        star.style.cssText = `
          left: ${cx}px; top: ${cy}px;
          background: ${colors[i % colors.length]};
          --tx: ${Math.cos(angle) * dist}px;
          --ty: ${Math.sin(angle) * dist}px;
          animation-delay: ${Math.random() * 0.3}s;
          animation-duration: ${1 + Math.random() * 0.8}s;
          width: ${2 + Math.random() * 4}px;
          height: ${2 + Math.random() * 4}px;
        `;
        konamiStars.appendChild(star);
      }
    }

    konamiClose.addEventListener('click', () => {
      konamiOverlay.classList.remove('active');
    });
  </script>
</body>
</html>