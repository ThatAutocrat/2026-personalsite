---
---
<section id="hero" class="hero">

  <!-- Grain texture overlay -->
  <div class="grain-overlay" aria-hidden="true">
    <svg width="0" height="0">
      <defs>
        <filter id="grain-filter">
          <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/>
          <feColorMatrix type="saturate" values="0"/>
          <feBlend in="SourceGraphic" mode="overlay"/>
        </filter>
      </defs>
    </svg>
  </div>

  <!-- Cursor glow -->
  <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

  <!-- BACKGROUND ORBIT -->
  <div class="orbit-bg" aria-hidden="true">
    <canvas id="orbit-canvas"></canvas>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-greeting animate-fade-up delay-1">
        <span class="blink">_</span> hello, world
      </p>
      <h1 class="hero-name animate-fade-up delay-2">
        <span class="name-split" id="name-first">Devashish</span><br />
        <span class="name-accent" id="name-last">Gogoi</span>
      </h1>
      <p class="hero-role animate-fade-up delay-3">
        <span class="role-tag">&lt;</span>
        <span class="role-cycler" id="role-cycler">
          <span class="role-word active">Full Stack Dev</span>
          <span class="role-word">Problem Solver</span>
          <span class="role-word">Fast Learner</span>
          <span class="role-word">Open to Work</span>
        </span>
        <span class="role-tag">/&gt;</span>
      </p>
      <p class="hero-desc animate-fade-up delay-4">
        Building performant, beautiful web experiences.<br />
        Currently learning about life &amp; crafting cool stuff.
      </p>

      <div class="hero-actions animate-fade-up delay-5">
        <a href="#projects" class="btn btn-primary magnetic" data-magnetic>View Projects</a>
        <a href="/assets/CV.png" download class="btn btn-secondary magnetic" data-magnetic>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          Download CV
        </a>
      </div>

      <div class="hero-links animate-fade-up delay-6">
        <a href="https://github.com/ThatAutocrat" target="_blank" rel="noopener" class="social-link">
          <span class="social-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </span>
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/devashish-gogoi-55b6b2223/" target="_blank" rel="noopener" class="social-link">
          <span class="social-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </span>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="hero-visual animate-fade-in delay-3" id="hero-visual">
      <div class="code-card" id="code-card">
        <div class="code-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="file-name">devashish.ts</span>
        </div>
        <pre class="code-body"><code id="typed-code"></code></pre>
      </div>
    </div>
  </div>

  <!-- EQ waveform -->
  <div class="waveform" id="waveform" aria-hidden="true">
    <canvas id="waveform-canvas"></canvas>
  </div>

  <!-- Keyboard shortcut hint -->
  <div class="kb-hint" id="kb-hint" aria-label="Press slash to search">
    <kbd>/</kbd><span>source code</span>
  </div>

  <!-- Shatter canvas -->
  <canvas id="shatter-canvas" aria-hidden="true"></canvas>

  <div class="scroll-hint" id="scroll-hint">
    <span>scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  /* ── Reset & Base ───────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 68px;
    position: relative;
    overflow: hidden;
  }

  /* ── Grain overlay ──────────────────────────────────── */
  .grain-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px 128px;
  }

  /* ── Cursor glow ────────────────────────────────────── */
  .cursor-glow {
    position: fixed;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 106, 247, 0.12) 0%, transparent 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 0;
    transition: opacity 0.3s;
    will-change: left, top;
  }

  /* ── Orbit canvas ───────────────────────────────────── */
  .orbit-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  #orbit-canvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
  }

  /* ── Layout ─────────────────────────────────────────── */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    position: relative;
    z-index: 1;
  }

  /* ── Text ───────────────────────────────────────────── */
  .hero-greeting {
    font-size: 0.78rem;
    color: var(--accent-2);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .blink {
    animation: pulse 1s ease-in-out infinite;
    color: var(--accent);
    font-weight: bold;
  }
  .hero-name {
    font-family: 'Syne', sans-serif;
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--text);
    margin-bottom: 1rem;
  }

  /* Letter-by-letter animation for name */
  .name-split .letter {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(10px);
    animation: letter-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes letter-in {
    to { opacity: 1; filter: blur(0); transform: translateY(0); }
  }

  .name-accent {
    display: inline-block;
    background: linear-gradient(135deg, var(--accent), var(--accent-2), #f472b6);
    background-size: 300% 300%;
    animation: gradientShift 4s ease infinite;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    transform: translateX(-40px);
    opacity: 0;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 5.6s,
                opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 5.6s;
  }
  .name-accent.visible {
    transform: translateX(0);
    opacity: 1;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50%       { background-position: 100% 50%; }
  }

  /* ── Role cycler ────────────────────────────────────── */
  .hero-role {
    font-size: 1rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.4em;
  }
  .role-tag { color: var(--accent); }
  .role-cycler {
    position: relative;
    display: inline-block;
    height: 1.4em;
    overflow: hidden;
    min-width: 120px;
  }
  .role-word {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease;
  }
  .role-word.active {
    transform: translateY(0);
    opacity: 1;
  }
  .role-word.exiting {
    transform: translateY(-100%);
    opacity: 0;
  }

  .hero-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  /* ── Magnetic buttons ───────────────────────────────── */
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .magnetic {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 0.2s ease;
  }

  /* ── Social links with pop animation ───────────────── */
  .hero-links { display: flex; gap: 1.5rem; }
  .social-link {
    display: flex; align-items: center; gap: 0.4rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.2s;
  }
  .social-link:hover { color: var(--accent); }
  .social-icon {
    display: inline-flex;
    transition: transform 0.15s cubic-bezier(0.34, 1.7, 0.64, 1);
  }
  .social-link:hover .social-icon {
    transform: scale(1.3) rotate(-8deg);
  }

  /* ── Code card ──────────────────────────────────────── */
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
  }
  .code-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
    transform-style: preserve-3d;
    animation: float 6s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.8rem 1rem;
    background: var(--bg-3);
    border-bottom: 1px solid var(--border);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.red    { background: #ff5f57; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green  { background: #28ca41; }
  .file-name {
    margin-left: 0.5rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .code-body {
    padding: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.8;
    overflow-x: auto;
    min-height: 220px;
  }

  /* Syntax colors with subtle glow on strings */
  .kw   { color: #c678dd; }
  .var  { color: #61afef; }
  .op   { color: var(--text-muted, #888); }
  .key  { color: #e06c75; }
  .str  {
    color: #98c379;
    text-shadow: 0 0 12px rgba(152, 195, 121, 0.25);
  }
  .bool { color: #d19a66; }
  .cursor-char {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--accent, #7c6af7);
    vertical-align: text-bottom;
    animation: blink-cur 0.8s step-end infinite;
    margin-left: 1px;
  }
  @keyframes blink-cur {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* ── Scroll hint ────────────────────────────────────── */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }
  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.8); }
    50%       { opacity: 1; transform: scaleY(1); }
  }

  /* ── Entrance animations ────────────────────────────── */
  .animate-fade-up {
    opacity: 0;
    transform: translateY(20px);
  }
  .animate-fade-in { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .animate-fade-up { animation: fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .animate-fade-in { animation: fade-in 0.7s ease forwards; }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-up,
    .animate-fade-in { opacity: 1; transform: none; animation: none; }
    .code-card        { transform: none; opacity: 1; }
    .name-accent      { transform: none; opacity: 1; }
    .name-split .letter { opacity: 1; filter: none; transform: none; animation: none; }
    .cursor-glow      { display: none; }
    .role-word { position: static; transform: none; opacity: 0; display: none; }
    .role-word.active { display: inline; opacity: 1; }
  }

  @keyframes fade-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in {
    to { opacity: 1; }
  }

  .delay-1 { animation-delay: 5.1s; }
  .delay-2 { animation-delay: 5.2s; }
  .delay-3 { animation-delay: 5.35s; }
  .delay-4 { animation-delay: 5.5s; }
  .delay-5 { animation-delay: 5.65s; }
  .delay-6 { animation-delay: 5.8s; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .hero-visual { order: -1; }
    .code-card { max-width: 420px; margin: 0 auto; }
    .scroll-hint { display: none; }
  }

  /* ── EQ Waveform ────────────────────────────────────── */
  .waveform {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.55;
  }
  #waveform-canvas {
    width: 100%;
    height: 100%;
  }

  /* ── Keyboard hint ──────────────────────────────────── */
  .kb-hint {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    opacity: 0;
    animation: kb-fadein 0.6s ease forwards;
    animation-delay: 7s;
    pointer-events: none;
    z-index: 2;
  }
  @keyframes kb-fadein {
    to { opacity: 0.28; }
  }
  .kb-hint kbd {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--accent, #7c6af7);
    border: 1px solid var(--accent, #7c6af7);
    border-radius: 4px;
    padding: 1px 5px;
    line-height: 1.6;
    background: transparent;
    opacity: 0.7;
  }
  .kb-hint span {
    font-size: 0.6rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .kb-hint:hover {
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  /* ── Shatter canvas ─────────────────────────────────── */
  #shatter-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    width: 100%;
    height: 100%;
  }

  /* Name clickable cursor hint */
  #name-first {
    cursor: pointer;
  }
  #name-first:hover .letter {
    text-shadow: 0 0 20px rgba(124,106,247,0.4);
    transition: text-shadow 0.3s;
  }

</style>

<script>
(function () {
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ──────────────────────────────────────────────────────
     1. LETTER-BY-LETTER NAME ENTRANCE
  ────────────────────────────────────────────────────── */
  if (!REDUCED) {
    const firstName = document.getElementById('name-first');
    const text = firstName.textContent;
    firstName.textContent = '';
    text.split('').forEach((ch, i) => {
      const span = document.createElement('span');
      span.className = 'letter';
      span.textContent = ch === ' ' ? '\u00a0' : ch;
      span.style.animationDelay = `${5.25 + i * 0.06}s`;
      firstName.appendChild(span);
    }); 

    // Gogoi slides in after first name finishes
    setTimeout(() => {
      document.getElementById('name-last').classList.add('visible');
    }, 4000);
  }

  /* ──────────────────────────────────────────────────────
     3. TYPING ANIMATION
  ────────────────────────────────────────────────────── */
  const codeLines = [
    { html: '<span class="kw">const</span> <span class="var">dev</span> <span class="op">=</span> {' },
    { html: '  <span class="key">name</span><span class="op">:</span> <span class="str">"Devashish Gogoi"</span>,' },
    { html: '  <span class="key">role</span><span class="op">:</span> <span class="str">"Full Stack Dev"</span>,' },
    { html: '  <span class="key">location</span><span class="op">:</span> <span class="str">"Assam, India"</span>,' },
    { html: '  <span class="key">stack</span><span class="op">:</span> [' },
    { html: '    <span class="str">"Node"</span>, <span class="str">"Express"</span>,' },
    { html: '    <span class="str">"TypeScript"</span>, <span class="str">"Astro"</span>' },
    { html: '  ],' },
    { html: '  <span class="key">currently</span><span class="op">:</span> <span class="str" id="cycling-val">"learning Rust"</span>,' },
    { html: '  <span class="key">open</span><span class="op">:</span> <span class="bool">true</span>' },
    { html: '};<span class="cursor-char"></span>' },
  ];

  const cyclingValues = ['"learning Rust"', '"building sites"', '"open to work"', '"reading docs"'];
  let cycleIdx = 0;

  const codeEl = document.getElementById('typed-code');
  const startDelay = REDUCED ? 0 : 6400; // wait for loader + stagger

  function typeLines() {
    let lineIdx = 0;
    let rendered = '';

    function nextLine() {
      if (lineIdx >= codeLines.length) {
        // Start cycling the "currently" value
        if (!REDUCED) startCycling();
        return;
      }
      rendered += codeLines[lineIdx].html + (lineIdx < codeLines.length - 1 ? '\n' : '');
      codeEl.innerHTML = rendered;
      lineIdx++;
      setTimeout(nextLine, REDUCED ? 0 : 60 + Math.random() * 30);
    }
    nextLine();
  }

  setTimeout(typeLines, startDelay);

  function startCycling() {
    setInterval(() => {
      cycleIdx = (cycleIdx + 1) % cyclingValues.length;
      const el = document.getElementById('cycling-val');
      if (!el) return;
      el.style.transition = 'opacity 0.3s, transform 0.3s';
      el.style.opacity = '0';
      el.style.transform = 'translateY(-6px)';
      setTimeout(() => {
        el.textContent = cyclingValues[cycleIdx];
        el.style.transform = 'translateY(6px)';
        requestAnimationFrame(() => {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        });
      }, 300);
    }, 2800);
  }

  /* ──────────────────────────────────────────────────────
     4. ROLE CYCLER (departure board)
  ────────────────────────────────────────────────────── */
  if (!REDUCED) {
    const words = document.querySelectorAll('.role-word');
    let current = 0;
    setInterval(() => {
      words[current].classList.remove('active');
      words[current].classList.add('exiting');
      setTimeout(() => words[current].classList.remove('exiting'), 500);
      current = (current + 1) % words.length;
      words[current].classList.add('active');
    }, 2500);
  }

  /* ──────────────────────────────────────────────────────
     5. CURSOR GLOW (lagged follow)
  ────────────────────────────────────────────────────── */
  if (!REDUCED) {
    const glow = document.getElementById('cursor-glow');
    let glowX = window.innerWidth / 2, glowY = window.innerHeight / 2;
    let targetX = glowX, targetY = glowY;

    window.addEventListener('mousemove', e => {
      targetX = e.clientX;
      targetY = e.clientY;
    });

    function animateGlow() {
      glowX += (targetX - glowX) * 0.07;
      glowY += (targetY - glowY) * 0.07;
      glow.style.left = glowX + 'px';
      glow.style.top  = glowY + 'px';
      requestAnimationFrame(animateGlow);
    }
    animateGlow();
  }

  /* ──────────────────────────────────────────────────────
     7. MAGNETIC BUTTONS
  ────────────────────────────────────────────────────── */
  if (!REDUCED) {
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      const RADIUS = 60;
      btn.addEventListener('mousemove', e => {
        const rect = btn.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top  + rect.height / 2;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < RADIUS) {
          const strength = (1 - dist / RADIUS) * 0.4;
          btn.style.transform = `translate(${dx * strength}px, ${dy * strength}px)`;
        }
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.transform = 'translate(0,0)';
      });
    });
  }

  /* ──────────────────────────────────────────────────────
     8. CANVAS ORBIT SYSTEM (full upgrade)
  ────────────────────────────────────────────────────── */
  (function () {
    const canvas = document.getElementById('orbit-canvas');
    const ctx    = canvas.getContext('2d');
    const hero   = document.getElementById('hero');

    let W, H, cx, cy;
    let mouseX = -9999, mouseY = -9999;
    let scrollFrac = 0;

    // Accent colors — match your CSS vars (fallback to defaults)
    const style  = getComputedStyle(document.documentElement);
    const ACC1   = style.getPropertyValue('--accent').trim()   || '#7c6af7';
    const ACC2   = style.getPropertyValue('--accent-2').trim() || '#a78bfa';

    function resize() {
      W = canvas.width  = canvas.offsetWidth;
      H = canvas.height = canvas.offsetHeight;
      cx = W / 2;
      cy = H / 2;
    }
    resize();
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', e => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });
    window.addEventListener('scroll', () => {
      scrollFrac = Math.min(window.scrollY / (hero.offsetHeight || 1), 1);
    }, { passive: true });

    // ── Ring definitions ──────────────────────────────
    // Each ring: rx, ry, base opacity, stroke width, draw-in timing
    const RINGS = [
      { rx0: 460, ry0: 200, opacity: 0.13, sw: 1,   drawDur: 2800, drawDelay: 5000  },
      { rx0: 340, ry0: 148, opacity: 0.18, sw: 1,   drawDur: 2200, drawDelay: 5400  },
      { rx0: 210, ry0: 92,  opacity: 0.24, sw: 1.2, drawDur: 1600, drawDelay: 5800  },
    ];

    // ── Dot definitions ───────────────────────────────
    // Each dot: ring index, start phase (0-1), direction, radius, color, speed multiplier
    const DOTS = [
      { ring: 0, phase: 0,    dir:  1, r: 5,   col: ACC2, speed: 1    },
      { ring: 0, phase: 0.5,  dir:  1, r: 3.5, col: ACC1, speed: 1    },
      { ring: 1, phase: 0.25, dir: -1, r: 4,   col: ACC2, speed: 1    },
      { ring: 2, phase: 0.1,  dir:  1, r: 3,   col: ACC1, speed: 1    },
    ];

    // Each dot maintains a trail of past positions
    DOTS.forEach(d => {
      d.currentPhase = d.phase;
      d.trail = [];
    });

    // ── Base orbit periods (seconds) ──────────────────
    const BASE_SPEED = [14, 9, 6];

    // ── Draw-in animation state ───────────────────────
    const startTime = performance.now();
    let drawn = [false, false, false];
    RINGS.forEach((r, i) => {
      setTimeout(() => { drawn[i] = true; }, r.drawDelay + r.drawDur + 100);
    });

    // ── Helper: ellipse point at angle t (radians) ───
    function ellipsePoint(rx, ry, t) {
      return { x: cx + rx * Math.cos(t), y: cy + ry * Math.sin(t) };
    }

    // ── Ellipse circumference (Ramanujan approx) ──────
    function ellipseC(rx, ry) {
      const h = (rx - ry) ** 2 / (rx + ry) ** 2;
      return Math.PI * (rx + ry) * (1 + (3 * h) / (10 + Math.sqrt(4 - 3 * h)));
    }

    // ── Deform ring path toward cursor ───────────────
    function buildRingPath(rx, ry, segments = 120) {
      const pts = [];
      for (let i = 0; i <= segments; i++) {
        const t  = (i / segments) * Math.PI * 2;
        let px = cx + rx * Math.cos(t);
        let py = cy + ry * Math.sin(t);

        // cursor deformation
        const dx = px - mouseX;
        const dy = py - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const PULL_RADIUS = 180;
        if (dist < PULL_RADIUS) {
          const strength = ((PULL_RADIUS - dist) / PULL_RADIUS) ** 2 * 22;
          px += (mouseX - px) / dist * strength;
          py += (mouseY - py) / dist * strength;
        }
        pts.push({ x: px, y: py });
      }
      return pts;
    }

    // ── Parse hex → {r,g,b} ──────────────────────────
    function hexToRgb(hex) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return { r, g, b };
    }
    const rgb1 = hexToRgb(ACC1.startsWith('#') ? ACC1 : '#7c6af7');
    const rgb2 = hexToRgb(ACC2.startsWith('#') ? ACC2 : '#a78bfa');

    // ── Main render loop ──────────────────────────────
    let lastTime = performance.now();

    function render(now) {
      requestAnimationFrame(render);
      const dt    = Math.min((now - lastTime) / 1000, 0.05);
      lastTime    = now;
      const elapsed = (now - startTime) / 1000;

      ctx.clearRect(0, 0, W, H);

      // Cursor distance to center (for glow)
      const cdx = mouseX - cx;
      const cdy = mouseY - cy;
      const cdist = Math.sqrt(cdx * cdx + cdy * cdy);

      // ── Breathe: rx, ry oscillate slightly ──────────
      RINGS.forEach((ring, i) => {
        const breathe = Math.sin(elapsed * 0.7 + i * 1.2) * 6;
        ring.rx = ring.rx0 + breathe;
        ring.ry = ring.ry0 + breathe * (ring.ry0 / ring.rx0);
      });

      // ── Scroll implosion ─────────────────────────────
      const scale = 1 - scrollFrac * 0.8;
      const alpha = 1 - scrollFrac;

      ctx.save();
      ctx.translate(cx * (1 - scale), cy * (1 - scale));
      ctx.scale(scale, scale);

      RINGS.forEach((ring, i) => {
        // draw-in progress
        const drawStart = ring.drawDelay / 1000;
        const drawEnd   = (ring.drawDelay + ring.drawDur) / 1000;
        const drawT     = Math.min(Math.max((elapsed - drawStart) / (drawEnd - drawStart), 0), 1);

        const pts    = buildRingPath(ring.rx, ring.ry);
        const total  = pts.length - 1;
        const visIdx = Math.floor(drawT * total);

        // Depth gradient: top of ring fades, bottom brightens
        ctx.beginPath();
        for (let j = 0; j <= visIdx; j++) {
          if (j === 0) ctx.moveTo(pts[j].x, pts[j].y);
          else         ctx.lineTo(pts[j].x, pts[j].y);
        }
        // Per-segment opacity based on Y position (depth cue)
        ctx.strokeStyle = ACC1;
        ctx.lineWidth   = ring.sw;
        ctx.globalAlpha = ring.opacity * alpha * (drawT < 1 ? drawT : 1);
        ctx.stroke();
      });

      // ── Dots ─────────────────────────────────────────
      DOTS.forEach((dot, di) => {
        const ring = RINGS[dot.ring];
        if (!ring) return;

        // Speed up when cursor is near
        const dotPt = ellipsePoint(ring.rx, ring.ry, dot.currentPhase * Math.PI * 2);
        const ddx = dotPt.x - mouseX;
        const ddy = dotPt.y - mouseY;
        const dotDist = Math.sqrt(ddx * ddx + ddy * ddy);
        const speedBoost = dotDist < 200 ? 1 + (1 - dotDist / 200) * 1.5 : 1;

        const period = BASE_SPEED[dot.ring];
        dot.currentPhase += dot.dir * (dt / period) * speedBoost;
        dot.currentPhase  = ((dot.currentPhase % 1) + 1) % 1;

        const t  = dot.currentPhase * Math.PI * 2;
        const px = cx + ring.rx * Math.cos(t);
        const py = cy + ring.ry * Math.sin(t);

        // Trail
        dot.trail.push({ x: px, y: py });
        if (dot.trail.length > 18) dot.trail.shift();

        // Draw trail
        if (dot.trail.length > 1) {
          for (let k = 1; k < dot.trail.length; k++) {
            const progress = k / dot.trail.length;
            ctx.beginPath();
            ctx.moveTo(dot.trail[k-1].x, dot.trail[k-1].y);
            ctx.lineTo(dot.trail[k].x,   dot.trail[k].y);
            ctx.strokeStyle = di % 2 === 0 ? ACC2 : ACC1;
            ctx.lineWidth   = dot.r * 0.5 * progress;
            ctx.globalAlpha = progress * 0.4 * alpha;
            ctx.stroke();
          }
        }

        // Draw dot
        ctx.beginPath();
        ctx.arc(px, py, dot.r, 0, Math.PI * 2);
        ctx.fillStyle   = di % 2 === 0 ? ACC2 : ACC1;
        ctx.globalAlpha = 0.9 * alpha;
        ctx.fill();

        // Glow around dot
        const grad = ctx.createRadialGradient(px, py, 0, px, py, dot.r * 3);
        grad.addColorStop(0, (di % 2 === 0 ? ACC2 : ACC1) + '55');
        grad.addColorStop(1, 'transparent');
        ctx.beginPath();
        ctx.arc(px, py, dot.r * 3, 0, Math.PI * 2);
        ctx.fillStyle   = grad;
        ctx.globalAlpha = 0.6 * alpha;
        ctx.fill();
      });

      // ── Cross-ring connection lines ───────────────────
      for (let a = 0; a < DOTS.length; a++) {
        for (let b = a + 1; b < DOTS.length; b++) {
          if (DOTS[a].ring === DOTS[b].ring) continue;
          const pa = DOTS[a].trail[DOTS[a].trail.length - 1];
          const pb = DOTS[b].trail[DOTS[b].trail.length - 1];
          if (!pa || !pb) continue;
          const ldx = pa.x - pb.x;
          const ldy = pa.y - pb.y;
          const ldist = Math.sqrt(ldx * ldx + ldy * ldy);
          if (ldist < 120) {
            ctx.beginPath();
            ctx.moveTo(pa.x, pa.y);
            ctx.lineTo(pb.x, pb.y);
            ctx.strokeStyle = ACC1;
            ctx.lineWidth   = 0.8;
            ctx.globalAlpha = (1 - ldist / 120) * 0.35 * alpha;
            ctx.stroke();
          }
        }
      }

      ctx.restore();
      ctx.globalAlpha = 1;
    }

    requestAnimationFrame(render);
  })();

  /* ──────────────────────────────────────────────────────
     9. HUE-SHIFT GOGOI NAME ON CURSOR X
  ────────────────────────────────────────────────────── */
  if (!REDUCED) {
    const nameAccent = document.getElementById('name-last');
    window.addEventListener('mousemove', e => {
      const frac = e.clientX / window.innerWidth;
      const deg  = Math.round(frac * 40 - 20); // -20deg to +20deg
      nameAccent.style.filter = `hue-rotate(${deg}deg)`;
    });
  }


  /* ──────────────────────────────────────────────────────
     10. EQ WAVEFORM (sine-driven, no audio)
  ────────────────────────────────────────────────────── */
  (function () {
    const canvas = document.getElementById('waveform-canvas');
    const ctx    = canvas.getContext('2d');
    const BAR_COUNT = 18;
    const GAP       = 3;
    let W, H;

    function resize() {
      W = canvas.width  = canvas.offsetWidth  * devicePixelRatio;
      H = canvas.height = canvas.offsetHeight * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);
    }
    resize();
    window.addEventListener('resize', resize);

    const cssStyle = getComputedStyle(document.documentElement);
    const acc = cssStyle.getPropertyValue('--accent').trim() || '#7c6af7';

    // Each bar has its own sine wave phase offset and frequency
    const bars = Array.from({ length: BAR_COUNT }, (_, i) => ({
      phase:  (i / BAR_COUNT) * Math.PI * 2,
      freq:   0.6 + Math.random() * 0.8,
      amp:    0.35 + Math.random() * 0.45,
    }));

    function render(now) {
      requestAnimationFrame(render);
      const cW = canvas.offsetWidth;
      const cH = canvas.offsetHeight;
      ctx.clearRect(0, 0, cW, H);

      const t = now / 1000;
      const barW = (cW - GAP * (BAR_COUNT - 1)) / BAR_COUNT;

      bars.forEach((bar, i) => {
        const sine   = Math.sin(t * bar.freq + bar.phase);
        const height = (0.18 + bar.amp * ((sine + 1) / 2)) * cH;
        const x      = i * (barW + GAP);
        const y      = cH - height;

        ctx.beginPath();
        ctx.roundRect(x, y, barW, height, 2);
        ctx.strokeStyle = acc;
       ctx.lineWidth   = 1;
       ctx.globalAlpha = 0.3 + 0.2 * ((sine + 1) / 2);
       ctx.stroke();
      });

      ctx.globalAlpha = 1;
    }

    requestAnimationFrame(render);
  })();

  /* ──────────────────────────────────────────────────────
     11. KEYBOARD SHORTCUT — Press / 
  ────────────────────────────────────────────────────── */
  (function () {
    window.addEventListener('keydown', e => {
      if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
        e.preventDefault();
        // Flash the hint, then focus search if it exists
        const hint = document.getElementById('kb-hint');
        if (hint) {
          hint.style.opacity = '1';
          hint.style.transition = 'opacity 0.1s';
          setTimeout(() => {
            hint.style.opacity = '';
            hint.style.transition = 'opacity 0.6s';
          }, 400);
        }
        // Try to focus a search input if you have one, or dispatch a custom event
        window.location.href = 'https://github.com/ThatAutocrat';
      }
    });
  })();

  /* ──────────────────────────────────────────────────────
     12. SHATTER + REASSEMBLE — click "Devashish"
  ────────────────────────────────────────────────────── */
  if (!REDUCED) {
    (function () {
      const nameEl  = document.getElementById('name-first');
      const canvas  = document.getElementById('shatter-canvas');
      const ctx     = canvas.getContext('2d');
      let particles = [];
      let animId    = null;
      let shattered = false;

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      const cssStyle = getComputedStyle(document.documentElement);
      const acc1 = cssStyle.getPropertyValue('--accent').trim()   || '#7c6af7';
      const acc2 = cssStyle.getPropertyValue('--accent-2').trim() || '#a78bfa';
      const textCol = cssStyle.getPropertyValue('--text').trim()  || '#f0f0f0';

      function getNameRect() {
        return nameEl.getBoundingClientRect();
      }

      function spawnParticles() {
        const rect   = getNameRect();
        const text   = 'Devashish';
        const fSize  = parseFloat(getComputedStyle(nameEl).fontSize);
        particles    = [];

        // Spawn ~180 particles spread across the name bounding box
        for (let i = 0; i < 180; i++) {
          const px = rect.left + Math.random() * rect.width;
          const py = rect.top  + Math.random() * rect.height;

          // velocity: burst outward from center of name
          const cx = rect.left + rect.width  / 2;
          const cy = rect.top  + rect.height / 2;
          const angle  = Math.atan2(py - cy, px - cx) + (Math.random() - 0.5) * 1.2;
          const speed  = 2 + Math.random() * 7;
          const colors = [acc1, acc2, textCol, '#fff'];

          particles.push({
            x: px, y: py,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - Math.random() * 3,
            alpha: 1,
            size: 1.5 + Math.random() * 3,
            color: colors[Math.floor(Math.random() * colors.length)],
            // reassemble target
            tx: px, ty: py,
            drag: 0.92,
            phase: 'shatter',
          });
        }
      }

      function animateShatter(timestamp) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        let allDone = true;
        particles.forEach(p => {
          if (p.phase === 'shatter') {
            p.vx *= p.drag;
            p.vy *= p.drag;
            p.vy += 0.18; // gravity
            p.x  += p.vx;
            p.y  += p.vy;
            p.alpha -= 0.008;
            if (p.alpha <= 0.05) { p.alpha = 0.05; }
            allDone = false;
          } else if (p.phase === 'reassemble') {
            const dx = p.tx - p.x;
            const dy = p.ty - p.y;
            p.x += dx * 0.09;
            p.y += dy * 0.09;
            p.alpha += 0.04;
            if (p.alpha > 1) p.alpha = 1;
            if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5 && p.alpha >= 0.98) {
              // done
            } else {
              allDone = false;
            }
          }

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = Math.max(0, p.alpha);
          ctx.fill();
        });

        ctx.globalAlpha = 1;

        if (!allDone) {
          animId = requestAnimationFrame(animateShatter);
        } else if (particles[0]?.phase === 'reassemble') {
          // All back — restore text, clear canvas
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          nameEl.style.opacity = '1';
          particles = [];
          shattered = false;
          animId    = null;
        }
      }

      function doShatter() {
        if (shattered) return;
        shattered = true;

        spawnParticles();
        // Hide real text so particles take over
        nameEl.style.opacity = '0';
        nameEl.style.transition = 'opacity 0s';

        if (animId) cancelAnimationFrame(animId);
        animId = requestAnimationFrame(animateShatter);

        // After 1.4s, switch particles to reassemble
        setTimeout(() => {
          particles.forEach(p => {
            p.phase = 'reassemble';
            p.alpha = Math.max(p.alpha, 0.1);
          });
        }, 1400);
      }

      nameEl.addEventListener('click', doShatter);

      // Subtle hint: add title attribute
      nameEl.setAttribute('title', 'Click me');
    })();
  }

})();
</script>