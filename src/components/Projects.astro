---
const projects = [
  {
    id: "animated-portfolio",
    title: "Pinakas",
    description: "Pinakas is a real-time kanban project management board built with SvelteKit 5, Lucia auth, and Supabase. Drag-and-drop tasks, live multi-user updates, tasks, emojis, and priority tracking.",
    tags: ["SvelteKit + Vanilla CSS", "Lucia v3", "Supabase"],
    github: "https://github.com/ThatAutocrat/Pinakas",
    live: "https://pinakas.vercel.app/",
    featured: true,
    image: "/assets/pinakas_mockup.png",
    caseStudy: {
      role: "Solo Developer & Designer",
      timeline: "3 weeks",
      overview: "Pinakas is a lightweight, real-time project management board built with SvelteKit 5 and Supabase.",
      problem: "Most project management tools are either overengineered for large teams or too simple to be useful. I wanted something in between — fast, opinionated, and actually pleasant to use.",
      solution: "Built the entire auth system from scratch using Lucia v3 with bcrypt instead of relying on third-party auth providers. Paired it with a Supabase Postgres backend and SvelteKit's server-side data loading for snappy performance. Added drag-and-drop task ordering, live multi-user updates via Supabase Realtime, and optimistic UI so every action feels instant even before the server confirms it.",
      stack: ["SvelteKit 5 · Supabase (Postgres + Realtime) · Lucia v3 · Vanilla CSS · Vercel"],
      outcomes: ["Optimistic UI makes the board feel native, not web-app sluggish", "Full auth flow with sessions, no third-party dependency", "Real-time collaboration works across multiple users with zero page refreshes"],
      lessons: "Rolling your own auth is educational until it isn't. Lucia abstracts just enough to stay sane without hiding what's actually happening. I'd do it again — but next time I'd add OAuth on day one."
    }
  },
  {
    id: "isekainexus",
    title: "Xrawler",
    description: "Dead link crawler built for developers. Paste a URL, get a full breakdown of alive, dead, timeout, and bot-blocked links across the page. Built for devs who'd rather know than guess.",
    tags: ["Hono", "React", "NodeJS"],
    live: "https://xrawler.vercel.app",
    github: "https://github.com/ThatAutocrat/xrawler",
    featured: true,
    image: "/assets/xrawler_mockup.png",
    caseStudy: {
      role: "Full-Stack Developer",
      timeline: "2 weeks",
      overview: "Xrawler is a developer tool for auditing broken links on any publicly accessible webpage. Built to be fast, honest, and useful — not a scraper, just a link health checker.",
      problem: "Your site has 200 links. Some are dead. You don't know which ones. Clicking them manually is not a personality trait.",
      solution: "Fetch the page, extract all anchor tags, batch-check each link concurrently, and return categorized results with response times. Rate limited to prevent abuse, CORS locked to the frontend.",
      stack: ["React + TypeScript — frontend", "Hono — lightweight backend framework", "Node.js on Render — backend hosting", "Vercel — frontend hosting"],
      outcomes: ["150 links checked per crawl", "Catches dead, alive, timeout, bot-blocked, and rate-limited responses", "Cloudflare-protected sites will still win. We're honest about it."],
      lessons: "Some sites don't want to be crawled. Some will block you. Some will gaslight you. Build around it or build a disclaimer — we chose both."
    }
  },
  {
    id: "tic-tac-toe",
    title: "Tic Tac Toe",
    description: "A modern take on the classic Tic Tac Toe — play solo against an AI, pass and play with a friend on the same device, or battle it out online in real-time using a room code. Clean dark UI, no downloads, just share the link and jump in.",
    tags: ["Express", "Node.js", "Vanilla JS"],
    github: "https://github.com/ThatAutocrat/Tic-Tac-Toe",
    live: "https://tic-tac-toe-kp86.onrender.com/",
    featured: false,
    video: "/assets/project-3.webm",
    caseStudy: {
      role: "Backend & Game Logic Developer",
      timeline: "1 week",
      overview: "What sounds like a toy project became a solid lesson in real-time architecture. The goal: take a childhood game and make it genuinely playable online with no friction — no accounts, no installs.",
      problem: "Real-time multiplayer feels complex to implement correctly. Race conditions, dropped connections, and game state sync are all real issues even in a simple 3x3 grid.",
      solution: "Built a WebSocket server with Socket.io on Express. Each game room gets a UUID — share it, and your opponent joins instantly. The AI opponent uses minimax with alpha-beta pruning so it's actually hard to beat.",
      stack: ["Node.js + Express — server", "Socket.io — real-time game sync", "Vanilla JS — zero-dependency frontend", "Render — hosting"],
      outcomes: ["Handles up to 50 concurrent rooms on a free Render tier", "AI is unbeatable on hard difficulty (minimax at full depth)", "Room-code flow gets players into a game in under 10 seconds"],
      lessons: "Vanilla JS forces you to understand the DOM instead of hiding behind frameworks. I now write framework code with much better awareness of what's actually happening underneath."
    }
  },
];
---

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-label">03 — projects</p>
      <h2 class="section-title">Things I've built<span class="accent-dot">.</span></h2>
      <div class="section-divider"></div>
    </div>

    <div class="projects-list">
      {projects.map((project, i) => (
        <div class={`project-row reveal ${project.featured ? 'featured' : ''}`} style={`--i: ${i}`}>
          <div class="project-image-wrap">
            {project.video ? (
              <>
                <video
                  src={project.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  class="project-img-backdrop"
                  aria-hidden="true"
                />
                <video
                  src={project.video}
                  autoplay
                  muted
                  loop
                  playsinline
                  class="project-img"
                />
              </>
            ) : (
              <img
                src={project.image}
                alt={project.title}
                class="project-img"
                onerror="this.style.display='none';"
              />
            )}
          </div>

          <div class="project-info">
            <div class="project-meta">
              {project.featured && <span class="featured-badge">Featured</span>}
              <span class="project-num">0{i + 1}</span>
            </div>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>
            <div class="project-tags">
              {project.tags.map(tag => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
            <div class="project-links">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="proj-link">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                  Source
                </a>
              )}
              {project.live && (
                <a href={project.live} target="_blank" rel="noopener" class="proj-link proj-link-live">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
                  </svg>
                  Live site
                </a>
              )}
              <button
                class="proj-link proj-link-case"
                data-case={project.id}
                aria-label={`Open case study for ${project.title}`}
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
                Case study
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="projects-cta reveal">
      <a href="https://github.com/ThatAutocrat" target="_blank" rel="noopener" class="btn btn-secondary">
        View all on GitHub →
      </a>
    </div>
  </div>
</section>

<!-- ── CASE STUDY MODAL ── -->
<div id="case-modal" class="case-overlay" role="dialog" aria-modal="true" aria-label="Case Study">
  <div class="case-panel">
    <button class="case-close" id="case-close" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="case-content" id="case-content">
      <!-- Injected by JS -->
    </div>
  </div>
</div>



<style>
  .projects { background: var(--bg-2); }
  .section-header { margin-bottom: 3.5rem; }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
    margin-bottom: 3.5rem;
  }

  .project-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-bottom: 1px solid var(--border);
    min-height: 340px;
    transition: background 0.3s;
  }
  .project-row:hover { background: rgba(124, 106, 247, 0.03); }
  .project-row.featured { grid-template-columns: 1.1fr 0.9fr; }

  .project-row:nth-child(even) .project-image-wrap { order: 2; }
  .project-row:nth-child(even) .project-info { order: 1; border-left: none; border-right: 1px solid var(--border); }

  .project-image-wrap {
    position: relative;
    overflow: hidden;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-img-backdrop {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    object-fit: cover;
    display: block;
    filter: blur(22px) brightness(0.35) saturate(1.4);
    transform: scale(1.05);
    pointer-events: none;
  }

  .project-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.4s;
    filter: grayscale(20%);
  }
  .project-row:hover .project-img { transform: scale(1.02); filter: grayscale(0%); }

  .project-info {
    padding: 2.5rem 2.8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    border-left: 1px solid var(--border);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .featured-badge {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-glow);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }
  .project-num {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-left: auto;
  }

  .project-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
    transition: color 0.3s;
  }
  .project-row:hover .project-title { color: var(--accent); }

  .project-desc {
    font-size: 0.83rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project-tag {
    font-size: 0.67rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    font-family: 'DM Mono', monospace;
    transition: all 0.2s;
  }
  .project-row:hover .project-tag { border-color: rgba(124,106,247,0.3); color: var(--accent); }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.3rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
    padding-bottom: 1px;
    border-bottom: 1px solid transparent;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    cursor: pointer;
  }
  .proj-link:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .proj-link-live { color: var(--accent); }
  .proj-link-live:hover { color: var(--accent-2); border-bottom-color: var(--accent-2); }
  .proj-link-case {
    color: var(--text-muted);
    background: var(--card-bg);
    border: 1px solid var(--border) !important;
    padding: 0.3rem 0.75rem;
    border-radius: 5px;
    transition: all 0.2s;
  }
  .proj-link-case:hover {
    color: var(--accent);
    border-color: var(--accent) !important;
    background: var(--accent-glow);
  }

  .projects-cta { display: flex; justify-content: center; }

  /* ── MODAL ── */
  .case-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .case-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .case-panel {
    background: var(--bg-3);
    border: 1px solid var(--border);
    border-bottom: none;
    border-radius: 20px 20px 0 0;
    width: 100%;
    max-width: 820px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 2.5rem 3rem 3.5rem;
    position: relative;
    transform: translateY(100%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 -24px 80px rgba(0,0,0,0.5);
  }
  .case-overlay.open .case-panel {
    transform: translateY(0);
  }

  /* custom scrollbar inside modal */
  .case-panel::-webkit-scrollbar { width: 3px; }
  .case-panel::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 2px; }

  .case-close {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.2s;
  }
  .case-close:hover { color: var(--text); border-color: var(--accent); background: var(--accent-glow); }

  /* drag pill */
  .case-panel::before {
    content: '';
    display: block;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: var(--border);
    margin: 0 auto 2rem;
  }

  /* ── CASE STUDY INNER CONTENT ── */
  .cs-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .cs-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 1.6rem;
    line-height: 1.1;
  }
  .cs-meta-row {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .cs-meta-item { display: flex; flex-direction: column; gap: 0.2rem; }
  .cs-meta-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .cs-meta-value {
    font-size: 0.85rem;
    color: var(--text);
    font-family: -apple-system, sans-serif;
  }

  .cs-section { margin-bottom: 1.8rem; }
  .cs-section-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .cs-section p, .cs-section li {
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--text-muted);
    font-family: -apple-system, 'SF Pro Text', sans-serif;
  }
  .cs-section ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cs-section ul li::before {
    content: '→ ';
    color: var(--accent);
  }
  .cs-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cs-stack-tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    transition: all 0.2s;
  }
  .cs-stack-tag:hover { border-color: var(--accent); color: var(--accent); }

  .cs-divider {
    height: 1px;
    background: var(--border);
    margin: 1.8rem 0;
  }

  @media (max-width: 768px) {
    .project-row,
    .project-row.featured { grid-template-columns: 1fr; }
    .project-row:nth-child(even) .project-image-wrap { order: 0; }
    .project-row:nth-child(even) .project-info { order: 0; border-right: none; border-left: 1px solid var(--border); }
    .project-image-wrap { border-right: none; border-bottom: 1px solid var(--border); }
    .project-info { padding: 1.8rem 1.5rem; border-left: none; }
    .case-panel { padding: 2rem 1.5rem 3rem; }
    .cs-meta-row { gap: 1.2rem; }
  }
</style>

<script define:vars={{ caseData: projects.map(p => ({ id: p.id, title: p.title, caseStudy: p.caseStudy })) }}>
  /* ── REVEAL ── */
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  /* ── CASE STUDY MODAL ── */
  // caseData is injected via define:vars above

  const overlay = document.getElementById('case-modal');
  const closeBtn = document.getElementById('case-close');
  const content  = document.getElementById('case-content');

  function openModal(id) {
    const project = caseData.find(p => p.id === id);
    if (!project) return;
    const cs = project.caseStudy;

    content.innerHTML = `
      <p class="cs-eyebrow">Case Study</p>
      <h2 class="cs-title">${project.title}</h2>

      <div class="cs-meta-row">
        <div class="cs-meta-item">
          <span class="cs-meta-label">Role</span>
          <span class="cs-meta-value">${cs.role}</span>
        </div>
        <div class="cs-meta-item">
          <span class="cs-meta-label">Timeline</span>
          <span class="cs-meta-value">${cs.timeline}</span>
        </div>
      </div>

      <div class="cs-section">
        <p class="cs-section-label">Overview</p>
        <p>${cs.overview}</p>
      </div>

      <div class="cs-divider"></div>

      <div class="cs-section">
        <p class="cs-section-label">The Problem</p>
        <p>${cs.problem}</p>
      </div>

      <div class="cs-section">
        <p class="cs-section-label">The Solution</p>
        <p>${cs.solution}</p>
      </div>

      <div class="cs-divider"></div>

      <div class="cs-section">
        <p class="cs-section-label">Tech Stack</p>
        <div class="cs-stack">
          ${cs.stack.map(s => `<span class="cs-stack-tag">${s}</span>`).join('')}
        </div>
      </div>

      <div class="cs-section">
        <p class="cs-section-label">Outcomes</p>
        <ul>${cs.outcomes.map(o => `<li>${o}</li>`).join('')}</ul>
      </div>

      <div class="cs-divider"></div>

      <div class="cs-section">
        <p class="cs-section-label">Key Lesson</p>
        <p>${cs.lessons}</p>
      </div>
    `;

    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-case]').forEach(btn => {
    btn.addEventListener('click', () => openModal(btn.dataset.case));
  });

  closeBtn.addEventListener('click', closeModal);

  overlay.addEventListener('click', e => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
  });
</script>
