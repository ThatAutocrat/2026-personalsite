---
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-logo"><span class="bracket">[</span>DG<span class="bracket">]</span></span>
      <p>Designed & built by Devashish Gogoi</p>
    </div>
    <div class="footer-right">
      <p>© 2026 — All rights reserved</p>
      <a href="#hero" class="back-top">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    background: var(--bg);
    position: relative;
    z-index: 1;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-left { display: flex; align-items: center; gap: 1rem; }
  .footer-logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--text);
  }
  .bracket { color: var(--accent); }
  .footer-left p, .footer-right p {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .footer-right { display: flex; align-items: center; gap: 1.5rem; }
  .back-top {
    font-size: 0.75rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .back-top:hover { opacity: 0.7; }
</style>
