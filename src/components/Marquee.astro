---
const row1 = ["Full Stack Dev", "Node.js", "Express", "TypeScript", "Astro", "Open to Work", "HTML & CSS", "JavaScript"];
const row2 = ["React", "Android", "Figma UI/UX", "Material UI", "C++", "Web Dev", "DSA", "Building Stuff"];
---

<div class="marquee-section">
  <div class="marquee-wrapper">
    <div class="marquee-track track-1">
      {[...row1, ...row1, ...row1, ...row1].map((item, i) => (
        <>
          <span class={`marquee-item ${i % 3 === 2 ? 'outline' : ''}`}>{item}</span>
          <span class="sep" aria-hidden="true"></span>
        </>
      ))}
    </div>
  </div>

  <div class="marquee-wrapper" style="margin-top: 0.75rem;">
    <div class="marquee-track track-2">
      {[...row2, ...row2, ...row2, ...row2].map((item, i) => (
        <>
          <span class={`marquee-item ${i % 3 === 1 ? 'outline' : ''}`}>{item}</span>
          <span class="sep" aria-hidden="true"></span>
        </>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-section {
    padding: 2.5rem 0;
    overflow: hidden;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  .marquee-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
  }

  .track-1 {
    animation: marquee-left 22s linear infinite;
  }
  .track-2 {
    animation: marquee-right 28s linear infinite;
  }

  

  @keyframes marquee-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    padding: 0 1.2rem;
    font-family: 'Syne', sans-serif;
    font-size: clamp(0.85rem, 1.5vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.2s;
    user-select: none;
  }

  .marquee-item.outline {
    -webkit-text-stroke: 1px var(--text-muted);
    color: transparent;
  }

  .marquee-section:hover .marquee-item:hover {
    color: var(--accent);
    -webkit-text-stroke-color: var(--accent);
  }

  .sep {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.5;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
